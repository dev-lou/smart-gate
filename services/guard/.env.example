# Smart Gate Guard Station - Environment Variables
# Copy this file to .env.local and fill in your values.

# Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Guard runs on port 3001



# Demo account shown under the sign-in form (seeded by database/seed-demo-user.sql).
# Leave blank to hide the demo block; never ship real admin credentials here.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
